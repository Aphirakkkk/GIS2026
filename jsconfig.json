{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": false,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "exclude": ["node_modules", "**/node_modules/*", "dist"]
}

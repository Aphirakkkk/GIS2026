// ============================================================
// GIS GROUP CMS V2
// Prisma Schema
// Backend: Express + TypeScript
// Database: MySQL
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsEventType {
  NEWS
  EVENT
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

// ============================================================
// AUTH / SECURITY
// ============================================================

// ------------------------------------------------------------
// USER
// ผู้ใช้งานระบบหลังบ้าน
// ------------------------------------------------------------

model User {
  id           BigInt     @id @default(autoincrement())
  username     String     @unique @db.VarChar(100)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  uploadedMedia Media[] @relation("MediaUploader")

  @@index([status])
  @@map("users")
}

// ------------------------------------------------------------
// ROLE
// เช่น superadmin / admin / editor
// ------------------------------------------------------------

model Role {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(255)
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// ------------------------------------------------------------
// PERMISSION
// เช่น project.create / project.update / news.delete
// ------------------------------------------------------------

model Permission {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique @db.VarChar(150)
  displayName String? @map("display_name") @db.VarChar(255)
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

// ------------------------------------------------------------
// USER ROLE
// users N:N roles
// ------------------------------------------------------------

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ------------------------------------------------------------
// ROLE PERMISSION
// roles N:N permissions
// ------------------------------------------------------------

model RolePermission {
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------
// REFRESH TOKEN
// ใช้ต่ออายุ Session / JWT
// ------------------------------------------------------------

model RefreshToken {
  id        BigInt @id @default(autoincrement())
  userId    BigInt @map("user_id")
  tokenHash String @unique @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------
// AUDIT LOG
// เก็บประวัติการทำรายการใน CMS
// ------------------------------------------------------------

model AuditLog {
  id BigInt @id @default(autoincrement())

  userId BigInt? @map("user_id")

  module     String  @db.VarChar(100)
  action     String  @db.VarChar(100)
  targetType String? @map("target_type") @db.VarChar(100)
  targetId   BigInt? @map("target_id")

  oldData Json? @map("old_data")
  newData Json? @map("new_data")

  ipAddress String? @map("ip_address") @db.VarChar(50)
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// MEDIA
// ============================================================

// ------------------------------------------------------------
// MEDIA
// เก็บ Metadata ของรูป/ไฟล์
// ไม่เก็บ Base64 ลง Database
// ------------------------------------------------------------

model Media {
  id BigInt @id @default(autoincrement())

  originalName String @map("original_name") @db.VarChar(255)
  fileName     String @map("file_name") @db.VarChar(255)

  mimeType String @map("mime_type") @db.VarChar(100)
  fileSize BigInt @map("file_size")

  storagePath String @map("storage_path") @db.VarChar(500)
  publicUrl   String @map("public_url") @db.VarChar(500)

  width  Int?
  height Int?

  altTextTh String? @map("alt_text_th") @db.VarChar(255)
  altTextEn String? @map("alt_text_en") @db.VarChar(255)

  uploadedBy BigInt? @map("uploaded_by")

  createdAt DateTime @default(now()) @map("created_at")

  uploadedByUser User? @relation("MediaUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  pageSections PageSection[] @relation("PageSectionMedia")

  banners Banner[] @relation("BannerMedia")

  businessCategoryIcons BusinessCategory[] @relation("BusinessCategoryIcon")
  businessMedia         BusinessMedia[]    @relation("BusinessMediaAsset")

  achievementCovers Achievement[]      @relation("AchievementCover")
  achievementMedia  AchievementMedia[] @relation("AchievementMediaAsset")

  newsEventCovers NewsEvent[]      @relation("NewsEventCover")
  newsEventMedia  NewsEventMedia[] @relation("NewsEventMediaAsset")

  projectCovers Project[]      @relation("ProjectCover")
  projectMedia  ProjectMedia[] @relation("ProjectMediaAsset")

  serviceMedia ServiceMedia[] @relation("ServiceMediaAsset")

  @@index([uploadedBy])
  @@map("media")
}

// ============================================================
// PAGE / CMS
// ============================================================

// ------------------------------------------------------------
// PAGE
// เช่น HOME / ABOUT / CONTACT
// ------------------------------------------------------------

model Page {
  id BigInt @id @default(autoincrement())

  code String @unique @db.VarChar(50)
  slug String @unique @db.VarChar(100)

  titleTh String  @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  status ContentStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections PageSection[]

  @@index([status])
  @@map("pages")
}

// ------------------------------------------------------------
// PAGE SECTION
// เช่น ABOUT → overview / values / policy / ISO
// ------------------------------------------------------------

model PageSection {
  id     BigInt @id @default(autoincrement())
  pageId BigInt @map("page_id")

  sectionKey  String  @map("section_key") @db.VarChar(100)
  sectionType String? @map("section_type") @db.VarChar(100)

  titleTh String? @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  subtitleTh String? @map("subtitle_th") @db.VarChar(255)
  subtitleEn String? @map("subtitle_en") @db.VarChar(255)

  contentTh String? @map("content_th") @db.LongText
  contentEn String? @map("content_en") @db.LongText

  mediaId BigInt? @map("media_id")

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  page  Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media Media? @relation("PageSectionMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([pageId, sectionKey])
  @@index([pageId, sortOrder])
  @@index([mediaId])
  @@index([status])
  @@map("page_sections")
}

// ============================================================
// MENU
// ============================================================

// ------------------------------------------------------------
// MENU
// เช่น HEADER / FOOTER
// ------------------------------------------------------------

model Menu {
  id BigInt @id @default(autoincrement())

  name     String @db.VarChar(100)
  location String @unique @db.VarChar(50)

  status    ContentStatus @default(PUBLISHED)
  sortOrder Int           @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items MenuItem[]

  @@index([status])
  @@map("menus")
}

// ------------------------------------------------------------
// MENU ITEM
// รองรับเมนู Parent / Child
// ------------------------------------------------------------

model MenuItem {
  id     BigInt @id @default(autoincrement())
  menuId BigInt @map("menu_id")

  parentId BigInt? @map("parent_id")

  titleTh String  @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  url String @db.VarChar(500)

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(PUBLISHED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuHierarchy")

  @@index([menuId, sortOrder])
  @@index([parentId])
  @@index([status])
  @@map("menu_items")
}

// ============================================================
// BANNER
// ============================================================

model Banner {
  id BigInt @id @default(autoincrement())

  pageCode String @map("page_code") @db.VarChar(50)

  titleTh String? @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  subtitleTh String? @map("subtitle_th") @db.VarChar(255)
  subtitleEn String? @map("subtitle_en") @db.VarChar(255)

  mediaId BigInt? @map("media_id")

  linkUrl    String? @map("link_url") @db.VarChar(500)
  linkTarget String? @map("link_target") @db.VarChar(20)

  startAt DateTime? @map("start_at")
  endAt   DateTime? @map("end_at")

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media Media? @relation("BannerMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([pageCode, status])
  @@index([mediaId])
  @@index([sortOrder])
  @@map("banners")
}

// ============================================================
// BUSINESS
// ============================================================

// ------------------------------------------------------------
// BUSINESS CATEGORY
// เดิม business_type
// ------------------------------------------------------------

model BusinessCategory {
  id BigInt @id @default(autoincrement())

  nameTh String  @map("name_th") @db.VarChar(255)
  nameEn String? @map("name_en") @db.VarChar(255)

  slug String @unique @db.VarChar(100)

  iconMediaId BigInt? @map("icon_media_id")

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(PUBLISHED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  iconMedia Media? @relation("BusinessCategoryIcon", fields: [iconMediaId], references: [id], onDelete: SetNull)

  businesses Business[]

  @@index([iconMediaId])
  @@index([status])
  @@map("business_categories")
}

// ------------------------------------------------------------
// BUSINESS
// เดิม business_home + business_detail
// ------------------------------------------------------------

model Business {
  id         BigInt @id @default(autoincrement())
  categoryId BigInt @map("category_id")

  slug String @unique @db.VarChar(150)

  titleTh String  @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  subtitleTh String? @map("subtitle_th") @db.VarChar(255)
  subtitleEn String? @map("subtitle_en") @db.VarChar(255)

  descriptionTh String? @map("description_th") @db.LongText
  descriptionEn String? @map("description_en") @db.LongText

  videoUrl String? @map("video_url") @db.VarChar(500)

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(DRAFT)

  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  media BusinessMedia[]

  @@index([categoryId])
  @@index([status, publishedAt])
  @@map("businesses")
}

// ------------------------------------------------------------
// BUSINESS MEDIA
// ------------------------------------------------------------

model BusinessMedia {
  businessId BigInt @map("business_id")
  mediaId    BigInt @map("media_id")

  sortOrder Int     @default(0) @map("sort_order")
  isCover   Boolean @default(false) @map("is_cover")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  media    Media    @relation("BusinessMediaAsset", fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([businessId, mediaId])
  @@index([mediaId])
  @@map("business_media")
}

// ============================================================
// ACHIEVEMENT
// ============================================================

model Achievement {
  id BigInt @id @default(autoincrement())

  titleTh String  @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  coverMediaId BigInt? @map("cover_media_id")

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coverMedia Media? @relation("AchievementCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  items AchievementItem[]
  media AchievementMedia[]

  @@index([coverMediaId])
  @@index([status])
  @@map("achievements")
}

// ------------------------------------------------------------
// ACHIEVEMENT ITEM
// ------------------------------------------------------------

model AchievementItem {
  id            BigInt @id @default(autoincrement())
  achievementId BigInt @map("achievement_id")

  eventDate DateTime? @map("event_date")

  titleTh String? @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  detailTh String? @map("detail_th") @db.Text
  detailEn String? @map("detail_en") @db.Text

  sortOrder Int @default(0) @map("sort_order")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([achievementId])
  @@map("achievement_items")
}

// ------------------------------------------------------------
// ACHIEVEMENT MEDIA
// ------------------------------------------------------------

model AchievementMedia {
  achievementId BigInt @map("achievement_id")
  mediaId       BigInt @map("media_id")

  sortOrder Int @default(0) @map("sort_order")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  media       Media       @relation("AchievementMediaAsset", fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([achievementId, mediaId])
  @@index([mediaId])
  @@map("achievement_media")
}

// ============================================================
// NEWS / EVENTS
// ============================================================

model NewsEvent {
  id BigInt @id @default(autoincrement())

  type NewsEventType

  slug String @unique @db.VarChar(191)

  titleTh String  @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  summaryTh String? @map("summary_th") @db.Text
  summaryEn String? @map("summary_en") @db.Text

  contentTh String? @map("content_th") @db.LongText
  contentEn String? @map("content_en") @db.LongText

  eventDate DateTime? @map("event_date")

  coverMediaId BigInt? @map("cover_media_id")

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  coverMedia Media? @relation("NewsEventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  media NewsEventMedia[]

  @@index([type])
  @@index([coverMediaId])
  @@index([status, publishedAt])
  @@map("news_events")
}

// ------------------------------------------------------------
// NEWS EVENT MEDIA
// ------------------------------------------------------------

model NewsEventMedia {
  newsEventId BigInt @map("news_event_id")
  mediaId     BigInt @map("media_id")

  sortOrder Int @default(0) @map("sort_order")

  newsEvent NewsEvent @relation(fields: [newsEventId], references: [id], onDelete: Cascade)
  media     Media     @relation("NewsEventMediaAsset", fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([newsEventId, mediaId])
  @@index([mediaId])
  @@map("news_event_media")
}

// ============================================================
// PROJECT REFERENCE
// ============================================================

// ------------------------------------------------------------
// PROJECT CATEGORY
// ------------------------------------------------------------

model ProjectCategory {
  id BigInt @id @default(autoincrement())

  nameTh String  @map("name_th") @db.VarChar(255)
  nameEn String? @map("name_en") @db.VarChar(255)

  slug String @unique @db.VarChar(150)

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(PUBLISHED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects Project[]

  @@index([status])
  @@map("project_categories")
}

// ------------------------------------------------------------
// PROJECT
// ------------------------------------------------------------

model Project {
  id         BigInt @id @default(autoincrement())
  categoryId BigInt @map("category_id")

  slug String @unique @db.VarChar(191)

  titleTh String  @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  segmentTh String? @map("segment_th") @db.VarChar(255)
  segmentEn String? @map("segment_en") @db.VarChar(255)

  projectOwnerTh String? @map("project_owner_th") @db.VarChar(255)
  projectOwnerEn String? @map("project_owner_en") @db.VarChar(255)

  projectValue Decimal? @map("project_value") @db.Decimal(15, 2)

  projectStartDate      DateTime? @map("project_start_date")
  projectCompletionDate DateTime? @map("project_completion_date")

  coverMediaId BigInt? @map("cover_media_id")

  status ContentStatus @default(DRAFT)

  publishedAt DateTime? @map("published_at")
  sortOrder   Int       @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverMedia Media?          @relation("ProjectCover", fields: [coverMediaId], references: [id], onDelete: SetNull)

  media ProjectMedia[]

  @@index([categoryId])
  @@index([coverMediaId])
  @@index([status, publishedAt])
  @@map("projects")
}

// ------------------------------------------------------------
// PROJECT MEDIA
// ------------------------------------------------------------

model ProjectMedia {
  projectId BigInt @map("project_id")
  mediaId   BigInt @map("media_id")

  sortOrder Int     @default(0) @map("sort_order")
  isCover   Boolean @default(false) @map("is_cover")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation("ProjectMediaAsset", fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([projectId, mediaId])
  @@index([mediaId])
  @@map("project_media")
}

// ============================================================
// PRODUCT / SERVICES
// ============================================================

// ------------------------------------------------------------
// SERVICE CATEGORY
// ------------------------------------------------------------

model ServiceCategory {
  id BigInt @id @default(autoincrement())

  nameTh String  @map("name_th") @db.VarChar(255)
  nameEn String? @map("name_en") @db.VarChar(255)

  slug String @unique @db.VarChar(150)

  sortOrder Int           @default(0) @map("sort_order")
  status    ContentStatus @default(PUBLISHED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  services Service[]

  @@index([status])
  @@map("service_categories")
}

// ------------------------------------------------------------
// SERVICE
// ------------------------------------------------------------

model Service {
  id         BigInt @id @default(autoincrement())
  categoryId BigInt @map("category_id")

  slug String @unique @db.VarChar(191)

  titleTh String  @map("title_th") @db.VarChar(255)
  titleEn String? @map("title_en") @db.VarChar(255)

  descriptionTh String? @map("description_th") @db.LongText
  descriptionEn String? @map("description_en") @db.LongText

  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  media ServiceMedia[]

  @@index([categoryId])
  @@index([status])
  @@map("services")
}

// ------------------------------------------------------------
// SERVICE MEDIA
// ------------------------------------------------------------

model ServiceMedia {
  serviceId BigInt @map("service_id")
  mediaId   BigInt @map("media_id")

  sortOrder Int     @default(0) @map("sort_order")
  isCover   Boolean @default(false) @map("is_cover")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  media   Media   @relation("ServiceMediaAsset", fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([serviceId, mediaId])
  @@index([mediaId])
  @@map("service_media")
}

// ============================================================
// CAREER
// ============================================================

model CareerPost {
  id BigInt @id @default(autoincrement())

  slug String @unique @db.VarChar(191)

  positionTh String  @map("position_th") @db.VarChar(255)
  positionEn String? @map("position_en") @db.VarChar(255)

  descriptionTh String? @map("description_th") @db.LongText
  descriptionEn String? @map("description_en") @db.LongText

  requirementsTh String? @map("requirements_th") @db.LongText
  requirementsEn String? @map("requirements_en") @db.LongText

  location       String? @db.VarChar(255)
  employmentType String? @map("employment_type") @db.VarChar(100)

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("career_posts")
}

// ============================================================
// CONTACT
// ============================================================

// ------------------------------------------------------------
// CONTACT SETTING
// ข้อมูลบริษัทสำหรับหน้า Contact
// ------------------------------------------------------------

model ContactSetting {
  id BigInt @id @default(autoincrement())

  companyNameTh String? @map("company_name_th") @db.VarChar(255)
  companyNameEn String? @map("company_name_en") @db.VarChar(255)

  addressTh String? @map("address_th") @db.Text
  addressEn String? @map("address_en") @db.Text

  phone String? @db.VarChar(100)
  email String? @db.VarChar(191)

  mapUrl      String? @map("map_url") @db.VarChar(500)
  facebookUrl String? @map("facebook_url") @db.VarChar(500)
  lineUrl     String? @map("line_url") @db.VarChar(500)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contact_settings")
}

// ------------------------------------------------------------
// CONTACT MESSAGE
// ข้อความที่ลูกค้าส่งมาจากหน้าเว็บไซต์
// ------------------------------------------------------------

model ContactMessage {
  id BigInt @id @default(autoincrement())

  name  String  @db.VarChar(255)
  email String? @db.VarChar(191)
  phone String? @db.VarChar(100)

  subject String? @db.VarChar(255)
  message String  @db.Text

  status ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}
